# MyAppsUptime Probe: small image without the UI and database
FROM python:3.12-slim

LABEL org.opencontainers.image.title="MyAppsUptime Probe"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# iputils-ping is needed for Ping monitors; cap_net_raw lets the non-root user ping on hosts without ping_group_range
RUN apt-get update \
    && apt-get install -y --no-install-recommends iputils-ping libcap2-bin \
    && setcap cap_net_raw+ep /bin/ping \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /probe
COPY probe/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Only the check code is shared with the server
COPY backend/app/__init__.py backend/app/checks.py backend/app/timeutil.py ./app/
COPY probe/*.py ./probe/

# Non-root; the probe writes nothing, so the root file system can be read-only
RUN groupadd --system --gid 10001 probe \
    && useradd --system --uid 10001 --gid 10001 --no-create-home probe
USER 10001:10001

CMD ["python", "-m", "probe"]

# MyAppsUptime Probe: small image without the UI and database
FROM python:3.12-slim

LABEL org.opencontainers.image.title="MyAppsUptime Probe"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# iputils-ping is needed for Ping monitors
RUN apt-get update \
    && apt-get install -y --no-install-recommends iputils-ping \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /probe
COPY probe/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Only the check code is shared with the server
COPY backend/app/__init__.py backend/app/checks.py backend/app/timeutil.py ./app/
COPY probe/*.py ./probe/

RUN useradd --system --uid 10001 probe
USER probe

CMD ["python", "-m", "probe"]
